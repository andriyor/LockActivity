# Copy to server/.env (gitignored) and fill in. Run: node --env-file=server/.env server/toggl-poll.mjs

# APNs key from developer.apple.com → Keys (absolute path; ~ is not expanded)
APNS_KEY_PATH=/Users/you/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YYYYYYYYYY
# api.sandbox.push.apple.com for Xcode builds, api.push.apple.com for TestFlight/App Store
APNS_HOST=api.sandbox.push.apple.com

# track.toggl.com/profile → API Token
TOGGL_API_TOKEN=

# Webhook mode only (toggl-webhook.mjs): the secret used when creating the subscription
TOGGL_WEBHOOK_SECRET=
